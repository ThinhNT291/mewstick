<Window x:Class="Mewstick.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh"
        Width="380" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="pack://application:,,,/Resources/Fonts/#Nunito"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource QuickPanelBrush}" CornerRadius="10" Padding="14"
            BorderBrush="{DynamicResource QuickBorderBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <TextBox x:Name="QuickAddTextBox" FontSize="14" Padding="8"
                     Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="1.5" BorderBrush="{DynamicResource QuickInputBorderBrush}"
                     KeyDown="QuickAddTextBox_KeyDown"/>
            <TextBlock Text="Enter để lưu · Esc để hủy" FontSize="11"
                       Foreground="{DynamicResource QuickHintBrush}" Margin="2,6,0,0"/>
        </StackPanel>
    </Border>
</Window>