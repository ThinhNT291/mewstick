<Window x:Class="Mewstick.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh"
        Width="380" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="pack://application:,,,/Resources/Fonts/#Nunito"
        Deactivated="Window_Deactivated">

    <Border Background="#EDEDEB" CornerRadius="10" Padding="14"
            BorderBrush="#B8B8B3" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <TextBox x:Name="QuickAddTextBox" FontSize="15" Padding="8"
                     Background="White" Foreground="Black"
                     BorderThickness="1.5" BorderBrush="#8A8A85"
                     KeyDown="QuickAddTextBox_KeyDown"/>
            <TextBlock Text="Enter để lưu · Esc để hủy" FontSize="11"
                       Foreground="#6E6E68" Margin="2,6,0,0"/>
        </StackPanel>
    </Border>
</Window>