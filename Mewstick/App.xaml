<Application x:Class="Mewstick.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Brush dùng chung cho giao diện sáng (mặc định); ThemeService thay bằng bộ màu tối khi bật Dark mode -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAFAF9"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#F0F0EE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F5F5F3"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#DADAD5"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#9A9A95"/>
        <SolidColorBrush x:Key="HelpPanelBrush" Color="#F5F5F0"/>
        <SolidColorBrush x:Key="MatrixPanelBrush" Color="#F0F0EC"/>
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="EditBoxBrush" Color="#20000000"/>
        <SolidColorBrush x:Key="SoftButtonBackgroundBrush" Color="#EEEEEE"/>
        <SolidColorBrush x:Key="HoverBellBrush" Color="#FFF3D6"/>
        <SolidColorBrush x:Key="HoverBoltBrush" Color="#F3E5F5"/>
        <SolidColorBrush x:Key="HoverTrashBrush" Color="#FFEBEE"/>
        <SolidColorBrush x:Key="QuickPanelBrush" Color="#EDEDEB"/>
        <SolidColorBrush x:Key="QuickBorderBrush" Color="#B8B8B3"/>
        <SolidColorBrush x:Key="QuickInputBorderBrush" Color="#8A8A85"/>
        <SolidColorBrush x:Key="QuickHintBrush" Color="#6E6E68"/>
    </Application.Resources>
</Application>
